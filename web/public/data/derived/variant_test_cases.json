{
 "about": "Query -> expected result for the variant lookup. Checked by pipeline/derive/variants.py against the Python reference parser (pipeline/derive/hgvs.py); the TypeScript port should pass the same cases. Only the keys listed under `expected` are compared.",
 "statuses": {
  "clinvar_match": "found among ClinVar pathogenic/likely-pathogenic records for a slice gene",
  "not_in_clinvar_plp": "slice gene recognised, variant not among ClinVar P/LP records; consequence read from the typed notation (fallback)",
  "gene_not_in_atlas": "a gene symbol outside the 11-gene slice was given",
  "not_found_no_gene": "variant notation parsed but no gene given and no slice gene has it",
  "unparsed": "no c., p. or copy-number notation recognised"
 },
 "cases": [
  {"query": "STXBP1 c.1162C>T p.Arg388*", "why": "full report line, c. and p. agree",
   "expected": {"status": "clinvar_match", "gene": "STXBP1", "accession": "VCV000006730", "consequence": "nonsense", "variant_group": "vg:STXBP1:truncating"}},
  {"query": "R388X", "why": "legacy 1-letter nonsense notation, no gene: gene inferred from the only match",
   "expected": {"status": "clinvar_match", "gene": "STXBP1", "accession": "VCV000006730"}},
  {"query": "NM_003165.6(STXBP1):c.1162C>T", "why": "different RefSeq transcript than ClinVar's title; matches with a transcript warning",
   "expected": {"status": "clinvar_match", "gene": "STXBP1", "accession": "VCV000006730"}},
  {"query": "STXBP1 p.Arg406His", "why": "3-letter missense at a recurrent residue",
   "expected": {"status": "clinvar_match", "gene": "STXBP1", "accession": "VCV000279904", "consequence": "missense", "variant_group": "vg:STXBP1:missense"}},
  {"query": "stxbp1 r406c", "why": "all lower case",
   "expected": {"status": "clinvar_match", "gene": "STXBP1", "accession": "VCV000207431"}},
  {"query": "STXBP1 c.1029+1G>A", "why": "canonical splice donor",
   "expected": {"status": "clinvar_match", "gene": "STXBP1", "accession": "VCV000870915", "consequence": "splice", "variant_group": "vg:STXBP1:splice"}},
  {"query": "SYT1 p.Ile368Thr", "why": "Baker-Gordon missense",
   "expected": {"status": "clinvar_match", "gene": "SYT1", "accession": "VCV000431484", "consequence": "missense"}},
  {"query": "SNAP25 p.(Ile67Asn)", "why": "predicted-consequence parentheses",
   "expected": {"status": "clinvar_match", "gene": "SNAP25", "accession": "VCV000253030", "consequence": "missense"}},
  {"query": "UNC13A P814L", "why": "1-letter missense without p.",
   "expected": {"status": "clinvar_match", "gene": "UNC13A", "accession": "VCV000996014"}},
  {"query": "SLC6A1 c.1070C>T", "why": "bridge gene, c. only",
   "expected": {"status": "clinvar_match", "gene": "SLC6A1", "accession": "VCV000542198", "consequence": "missense"}},
  {"query": "VAMP2 p.Arg56Ter", "why": "3-letter Ter",
   "expected": {"status": "clinvar_match", "gene": "VAMP2", "accession": "VCV000929460", "consequence": "nonsense", "variant_group": "vg:VAMP2:truncating"}},
  {"query": "SLC6A1 p.Ser295Leu", "why": "MISS: variant of the n=1 AAV9 trial (NCT07173153) is not among ClinVar P/LP records; fallback by pattern",
   "expected": {"status": "not_in_clinvar_plp", "consequence": "missense", "variant_group": "vg:SLC6A1:missense"}},
  {"query": "SYT2 p.Pro308Leu", "why": "MISS: published dominant presynaptic-CMS variant (PMID:26519543) not among ClinVar P/LP records",
   "expected": {"status": "not_in_clinvar_plp", "consequence": "missense", "variant_group": "vg:SYT2:missense"}},
  {"query": "STX1B c.500_501del", "why": "MISS: 2-bp deletion, frameshift inferred from length",
   "expected": {"status": "not_in_clinvar_plp", "consequence": "frameshift", "variant_group": "vg:STX1B:truncating"}},
  {"query": "STXBP1 c.9999C>T", "why": "MISS: exonic substitution, protein effect cannot be read from c. alone",
   "expected": {"status": "not_in_clinvar_plp", "consequence": "other", "variant_group": null}},
  {"query": "SNAP25 c.1A>G", "why": "MISS: start codon change, grouped with truncating",
   "expected": {"status": "not_in_clinvar_plp", "consequence": "other", "variant_group": "vg:SNAP25:truncating"}},
  {"query": "STXBP1 whole gene deletion", "why": "copy-number wording",
   "expected": {"status": "not_in_clinvar_plp", "consequence": "cnv", "variant_group": "vg:STXBP1:whole-gene-deletion"}},
  {"query": "SCN1A c.1234C>T", "why": "non-slice gene",
   "expected": {"status": "gene_not_in_atlas"}},
  {"query": "MECP2 p.Arg168*", "why": "non-slice gene with a nonsense change",
   "expected": {"status": "gene_not_in_atlas"}},
  {"query": "my child has a mutation", "why": "no notation",
   "expected": {"status": "unparsed"}}
 ]
}
