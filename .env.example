# Copy this file to .env.local and fill in the values. .env.local is gitignored; never commit it.

# Bright Data: account API token (Quick start bar on the dashboard home page) and the zone names
# shown when you create each API under Web Access
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_SERP_ZONE=serp_api1
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1

# Optional fallback when nobody is signed in with ChatGPT
OPENAI_API_KEY=
OPENAI_MODEL=
